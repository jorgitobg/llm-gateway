# Copy to .env (never commit it). All values are optional for the offline demo.
LLM_GATEWAY_PROVIDERS=fake
# For a real OpenAI-compatible endpoint (OpenAI, OpenRouter, llama.cpp, Ollama):
# LLM_GATEWAY_PROVIDERS=openai-compatible,fake
# LLM_GATEWAY_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_GATEWAY_UPSTREAM_MODEL=your-model-name
# LLM_GATEWAY_UPSTREAM_API_KEY=
# Reasoning models spend output tokens on hidden thinking; give them room:
# LLM_GATEWAY_MAX_OUTPUT_TOKENS=2048
